{
  "name": "temu-exact-match",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "description": "TEMU 美国站真实页面读取与严格同款分析浏览器插件",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
